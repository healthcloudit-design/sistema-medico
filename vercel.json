{
  "rewrites": [
    {
      "source": "/privacidad.html",
      "destination": "/privacidad.html"
    },
    {
      "source": "/agenda/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/agenda/favicon.png",
      "destination": "/favicon.png"
    },
    {
      "source": "/agenda/praxis_logo.png",
      "destination": "/praxis_logo.png"
    },
    {
      "source": "/agenda/msf_logo.png",
      "destination": "/msf_logo.png"
    },
    {
      "source": "/agenda/tigre_logo.svg",
      "destination": "/tigre_logo.svg"
    },
    {
      "source": "/agenda/josecpaz_logo.png",
      "destination": "/josecpaz_logo.png"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}